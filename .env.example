# Neon Postgres connection string. Keep the real value only in .env.local / Vercel.
DATABASE_URL=

# Create these in Neon Auth before enabling sign-in routes.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Obrigatória em produção. Em desenvolvimento, a origem local da requisição é aceita automaticamente.
APP_ORIGIN=http://localhost:3000

# Upstash Redis REST credentials used for distributed API rate limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=
